# Absolute origin the site is served from. Used to make the social preview
# tags absolute — a relative og:image is ignored by most link unfurlers, so a
# shared link shows no picture without this.
VITE_SITE_URL=https://sreetam-and-bhavna.example

# Deploy path prefix. "/" for a custom domain; "/<repo-name>/" for GitHub Pages.
VITE_BASE_PATH=/
